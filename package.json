{
  "name": "boootie-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "boootie.com: single-page pre-order site",
  "scripts": {
    "doodles": "node scripts/doodles.mjs",
    "css": "tailwindcss -i src/css/input.css -o dist/style.css --minify",
    "html": "node scripts/build.mjs",
    "build": "npm run doodles && npm run css && npm run html",
    "dev": "npm run build && npx serve dist",
    "renders": "node scripts/render.mjs",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2",
    "playwright": "^1.56.1",
    "sharp": "^0.34.3"
  },
  "dependencies": {
    "tailwindcss": "^4.1.14",
    "@tailwindcss/cli": "^4.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
