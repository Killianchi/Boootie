#!/usr/bin/env python3
"""Fake `cua-driver` for tests: logs each `call` to $FAKE_CUA_LOG, fakes a 2x snapshot."""
import json, os, sys
from PIL import Image

_, cmd, tool, raw = sys.argv[:4]
args = json.loads(raw)
with open(os.environ["FAKE_CUA_LOG"], "a") as f:
    f.write(json.dumps({"tool": tool, "args": args}) + "\n")
if os.environ.get("FAKE_CUA_FAIL") == tool:
    print('{"isError": true, "content": [{"type": "text", "text": "simulated failure"}]}')
    sys.exit(1)
if tool == "get_window_state" and args.get("screenshot_out_file"):
    Image.new("RGB", (636, 1402)).save(args["screenshot_out_file"])  # 318x701 pt window at 2x
print(json.dumps({"isError": False, "content": [{"type": "text", "text": "ok"}]}))
